{
  "$comment": "[reviewed-dataset] - START: Schema structure. Dataset validator additionally checks image files/hashes, pixel bounds, cross-row identity/timing and explicit review. [reviewed-dataset] - END [model-review] - START: schema_version 1 = reviewed provenance: human_review (a person) or ai_review (an AI reviewer: reviewer \"ai/<name>\", provenance reviewer_kind \"ai\" and review_channel; accepted in gold like human_review); schema_version 2 = model_review provenance with review_model, review_model_version, review_model_sha256 and confidence (training-candidate datasets only; gold rejects model review). [model-review] - END",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "label_basis": {
                "enum": [
                  "ai_review",
                  "human_review"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "confidence": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "label_basis": {
                "const": "model_review"
              },
              "review_model": {
                "minLength": 1,
                "type": "string"
              },
              "review_model_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "review_model_version": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "label_basis",
              "source_review_sha256",
              "review_model",
              "review_model_version",
              "review_model_sha256",
              "confidence"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "label_basis": {
                "const": "ai_review"
              }
            },
            "required": [
              "label_basis"
            ]
          }
        },
        "required": [
          "provenance"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "label_basis",
              "source_review_sha256",
              "reviewer_kind",
              "review_channel"
            ]
          },
          "reviewer": {
            "pattern": "^[Aa][Ii]/"
          }
        }
      }
    }
  ],
  "properties": {
    "alignment_status": {
      "enum": [
        "exact",
        "unresolved"
      ]
    },
    "annotation_id": {
      "minLength": 1,
      "type": "string"
    },
    "applicability": {
      "enum": [
        "other_road",
        "own_road",
        "unresolved"
      ]
    },
    "bbox_xyxy": {
      "items": {
        "type": "number"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": [
        "array",
        "null"
      ]
    },
    "camera_stream": {
      "enum": [
        "narrow_road",
        "q_narrow_road",
        "wide_road"
      ]
    },
    "capture_mono_ns": {
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "capture_time_provenance": {
      "enum": [
        "encode_index_eof",
        "encode_index_sof",
        "unknown"
      ]
    },
    "decoded_frame_index": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "encounter_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "height": {
      "minimum": 1,
      "type": "integer"
    },
    "image_path": {
      "minLength": 1,
      "type": "string"
    },
    "image_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "occlusion": {
      "enum": [
        "heavy",
        "none",
        "partial",
        "unknown"
      ]
    },
    "output_index": {
      "minimum": 0,
      "type": "integer"
    },
    "proposal_score": {
      "maximum": 1,
      "minimum": 0,
      "type": [
        "number",
        "null"
      ]
    },
    "proposal_source": {
      "minLength": 1,
      "type": "string"
    },
    "provenance": {
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "label_basis": {
          "enum": [
            "ai_review",
            "human_review",
            "model_review"
          ]
        },
        "review_channel": {
          "enum": [
            "mcp",
            "rest",
            "web"
          ]
        },
        "review_model": {
          "minLength": 1,
          "type": "string"
        },
        "review_model_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "review_model_version": {
          "minLength": 1,
          "type": "string"
        },
        "reviewer_kind": {
          "const": "ai"
        },
        "source_review_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "label_basis",
        "source_review_sha256"
      ],
      "type": "object"
    },
    "review_state": {
      "enum": [
        "accepted",
        "corrected",
        "pending",
        "rejected"
      ]
    },
    "review_timestamp": {
      "format": "date-time",
      "minLength": 1,
      "type": "string"
    },
    "reviewer": {
      "minLength": 1,
      "type": "string"
    },
    "route_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "segment_index": {
      "minimum": 0,
      "type": "integer"
    },
    "sign_family": {
      "enum": [
        "cancellation",
        "maximum_speed",
        "not_a_sign",
        "other_sign",
        "road_marking",
        "unreadable",
        "variable_display",
        "zone"
      ]
    },
    "site_group": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "source_log_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "source_video_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "plate_hours": {
      "description": "The hours of a plate when the reviewer read them: from-to in whole hours, such as 22-6. Only with family maximum_speed and supplementary_panel time.",
      "type": ["string", "null"],
      "pattern": "^([0-9]|1[0-9]|2[0-3])-([0-9]|1[0-9]|2[0-3])$"
    },
    "supplementary_panel": {
      "enum": [
        "none",
        "present",
        "time",
        "unknown",
        "unresolved"
      ]
    },
    "temporary": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "value_kph": {
      "maximum": 250,
      "minimum": 5,
      "type": [
        "integer",
        "null"
      ]
    },
    "value_state": {
      "enum": [
        "not_applicable",
        "read",
        "unknown",
        "unreadable"
      ]
    },
    "variable_display": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "visibility": {
      "enum": [
        "clear",
        "partial",
        "poor",
        "unknown"
      ]
    },
    "width": {
      "minimum": 1,
      "type": "integer"
    },
    "country": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 country of the frame (GPS or reviewer); optional: rows imported before it may miss it"
    },
    "gps": {
      "type": [
        "object",
        "null"
      ],
      "description": "where the car was at the frame (nnslr gps); optional",
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "speed_mps": {
          "type": [
            "number",
            "null"
          ]
        },
        "bearing_deg": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "sign_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "pedestrian_crossing",
        "children",
        "cyclists",
        "traffic_queue",
        "roadworks",
        "danger_other",
        "give_way",
        "stop",
        "priority_to_right",
        "main_road",
        "main_road_end",
        "no_overtaking",
        "no_overtaking_end",
        "no_entry",
        "minimum_speed",
        "weight_limit",
        "height_limit",
        "width_limit",
        "keep_right",
        "keep_left",
        "ahead_only",
        "town_entry",
        "town_exit",
        "motorway_start",
        "motorway_end",
        "expressway_start",
        "expressway_end",
        "roundabout",
        "one_way",
        "direction_left",
        "direction_right",
        "direction_straight",
        "direction_several",
        "other",
        "on_vehicle",
        null
      ],
      "description": "kind of an other_sign box, or on_vehicle for a not_a_sign box; optional"
    },
    "painted": {
      "type": [
        "boolean",
        "null"
      ],
      "enum": [
        true,
        null
      ],
      "description": "an other_sign box painted on the road (true), its sign_type still what it means; optional"
    },
    "sign_value": {
      "description": "Original written number. value_kph is a legacy alias, never a conversion.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 5,
      "maximum": 250
    },
    "sign_unit": {
      "enum": [
        "km/h",
        "mph",
        "unknown",
        null
      ]
    }
  },
  "required": [
    "alignment_status",
    "annotation_id",
    "applicability",
    "bbox_xyxy",
    "camera_stream",
    "capture_mono_ns",
    "capture_time_provenance",
    "decoded_frame_index",
    "encounter_id",
    "height",
    "image_path",
    "image_sha256",
    "notes",
    "occlusion",
    "output_index",
    "proposal_score",
    "proposal_source",
    "provenance",
    "review_state",
    "review_timestamp",
    "reviewer",
    "route_id",
    "schema_version",
    "segment_index",
    "sign_family",
    "site_group",
    "source_log_sha256",
    "source_video_sha256",
    "supplementary_panel",
    "temporary",
    "value_kph",
    "value_state",
    "variable_display",
    "visibility",
    "width"
  ],
  "title": "NNSLR canonical annotation v1",
  "type": "object"
}
